# Normalize line endings: LF in the repo, native in the working copy.
# Keeps Windows checkouts from producing CRLF diffs against Vercel's Linux builds.
* text=auto eol=lf

# Binary / generated — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
package-lock.json -diff linguist-generated
