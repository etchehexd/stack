# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → Data API  (URL)
# Dashboard → Project Settings → API Keys  (anon / publishable key)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role / secret key. SERVER ONLY — bypasses Row Level Security.
# Used exclusively by scripts/sync-anilist.ts and the cron route handler.
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── App ─────────────────────────────────────────────────────────────────────
# Used to build OAuth redirect URLs. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shared secret protecting /api/cron/sync so only your scheduler can call it.
# Generate one with:  node -e "console.log(require('crypto').randomUUID())"
CRON_SECRET="generate-a-random-string"
